{
  "cleanUrls": true,
  "redirects": [
    { "source": "/department", "destination": "/departments", "permanent": true },
    { "source": "/department.html", "destination": "/departments", "permanent": true },
    { "source": "/orescation", "destination": "/prescription", "permanent": true }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
